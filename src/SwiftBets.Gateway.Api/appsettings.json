{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FaultInjection": {
    "Enabled": false
  },
  "Gateway": {
    "IdentityAddress": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "placement",
        "Match": {
          "Path": "/api/auth/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "coupons": {
        "ClusterId": "placement",
        "Match": {
          "Path": "/api/coupons/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "me": {
        "ClusterId": "placement",
        "Match": {
          "Path": "/api/me/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "fixtures": {
        "ClusterId": "offer",
        "Match": {
          "Path": "/api/fixtures/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "accounts": {
        "ClusterId": "wallet",
        "Match": {
          "Path": "/api/accounts/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "steward": {
        "ClusterId": "steward",
        "Match": {
          "Path": "/api/steward/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/steward"
          }
        ]
      },
      "hubs": {
        "ClusterId": "realtime",
        "Match": {
          "Path": "/api/hubs/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "dashboard": {
        "ClusterId": "dashboard",
        "Match": {
          "Path": "/{**rest}"
        },
        "Transforms": [],
        "Order": 1000
      }
    },
    "Clusters": {
      "placement": {
        "Destinations": {
          "primary": {
            "Address": "http://placement:8080"
          }
        }
      },
      "offer": {
        "Destinations": {
          "primary": {
            "Address": "http://offer:8080"
          }
        }
      },
      "wallet": {
        "Destinations": {
          "primary": {
            "Address": "http://wallet:8080"
          }
        }
      },
      "dashboard": {
        "Destinations": {
          "primary": {
            "Address": "http://dashboard:8080"
          }
        }
      },
      "steward": {
        "Destinations": {
          "primary": {
            "Address": "http://steward:8080"
          }
        }
      },
      "realtime": {
        "Destinations": {
          "primary": {
            "Address": "http://realtime:8080"
          }
        },
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": "sb_rt"
        }
      }
    }
  }
}
