{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FaultInjection": {
    "Enabled": false
  },
  "Gateway": {
    "IdentityAddress": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "profile": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/profile"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "admin-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/admin/users/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "admin-compliance": {
        "ClusterId": "compliance",
        "Match": {
          "Path": "/api/admin/users/{userId}/compliance"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "admin-audit": {
        "ClusterId": "compliance",
        "Match": {
          "Path": "/api/admin/audit/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "coupons": {
        "ClusterId": "placement",
        "Match": {
          "Path": "/api/coupons/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "me": {
        "ClusterId": "placement",
        "Match": {
          "Path": "/api/me/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "me-compliance": {
        "ClusterId": "compliance",
        "Match": {
          "Path": "/api/me/compliance"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "me-limits": {
        "ClusterId": "compliance",
        "Match": {
          "Path": "/api/me/limits/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "me-exclusions": {
        "ClusterId": "compliance",
        "Match": {
          "Path": "/api/me/exclusions"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "me-session-settings": {
        "ClusterId": "compliance",
        "Match": {
          "Path": "/api/me/session-settings"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "fixtures": {
        "ClusterId": "offer",
        "Match": {
          "Path": "/api/fixtures/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "accounts": {
        "ClusterId": "wallet",
        "Match": {
          "Path": "/api/accounts/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "steward": {
        "ClusterId": "steward",
        "Match": {
          "Path": "/api/steward/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/steward"
          }
        ]
      },
      "hubs": {
        "ClusterId": "realtime",
        "Match": {
          "Path": "/api/hubs/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "ops": {
        "ClusterId": "dashboard",
        "Match": {
          "Path": "/ops/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/ops"
          }
        ]
      },
      "site-account": {
        "ClusterId": "site",
        "Match": {
          "Path": "/account/{**rest}"
        }
      },
      "site-account-root": {
        "ClusterId": "site",
        "Match": {
          "Path": "/account"
        }
      },
      "site-assets": {
        "ClusterId": "site",
        "Match": {
          "Path": "/site-assets/{**rest}"
        }
      },
      "site-manifest": {
        "ClusterId": "site",
        "Match": {
          "Path": "/__manifest"
        }
      },
      "web": {
        "ClusterId": "web",
        "Match": {
          "Path": "/{**rest}"
        },
        "Order": 1000
      }
    },
    "Clusters": {
      "placement": {
        "Destinations": {
          "primary": {
            "Address": "http://placement:8080"
          }
        }
      },
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://placement:8080"
          }
        }
      },
      "offer": {
        "Destinations": {
          "primary": {
            "Address": "http://offer:8080"
          }
        }
      },
      "wallet": {
        "Destinations": {
          "primary": {
            "Address": "http://wallet:8080"
          }
        }
      },
      "dashboard": {
        "Destinations": {
          "primary": {
            "Address": "http://dashboard:8080"
          }
        }
      },
      "steward": {
        "Destinations": {
          "primary": {
            "Address": "http://steward:8080"
          }
        }
      },
      "realtime": {
        "Destinations": {
          "primary": {
            "Address": "http://realtime:8080"
          }
        },
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": "sb_rt"
        }
      },
      "web": {
        "Destinations": {
          "primary": {
            "Address": "http://web:8080"
          }
        }
      },
      "site": {
        "Destinations": {
          "primary": {
            "Address": "http://site:8080"
          }
        }
      },
      "compliance": {
        "Destinations": {
          "primary": {
            "Address": "http://compliance:8080"
          }
        }
      }
    }
  }
}
